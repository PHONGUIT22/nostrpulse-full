{
  "name": "nostrpulse-mcp",
  "version": "1.3.1",
  "description": "Autonomous payment & Web-of-Trust anti-Sybil layer for AI agents via Nostr & Cashu (NIP-61 NutZaps).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PHONGUIT22/nostrpulse-full.git"
  },
  "mcpName": "io.github.PHONGUIT22/nostrpulse",
  "main": "./dist/mcp-entry.js",
  "exports": {
    ".": {
      "import": "./dist/mcp-entry.js",
      "default": "./dist/mcp-entry.js"
    },
    "./sdk": {
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    }
  },
  "bin": {
    "nostrpulse-mcp": "dist/mcp-entry.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-all-tests.ts",
    "indexer": "tsx scripts/indexer-worker.ts",
    "enrich": "node src/scripts/enrich-creators.mjs",
    "mcp": "tsx src/mcp-entry.ts",
    "build:mcp": "tsup",
    "agent": "tsx src/agent/cli.ts",
    "agent:llm": "tsx src/agent/cli.ts --mode=llm",
    "agent:local": "tsx src/agent/cli.ts --mode=local"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.58",
    "@ai-sdk/react": "^4.0.95",
    "@base-ui/react": "^1.7.0",
    "@cashu/cashu-ts": "^4.9.0",
    "@getalby/bitcoin-connect": "^3.12.3",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^7.0.92",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "nostr-tools": "^2.25.0",
    "openai": "^7.15.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
